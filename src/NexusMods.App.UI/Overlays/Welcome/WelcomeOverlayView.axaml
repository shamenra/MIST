<reactive:ReactiveUserControl
    x:TypeArguments="overlays:IWelcomeOverlayViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactive="http://reactiveui.net"
    xmlns:overlays="clr-namespace:NexusMods.App.UI.Overlays"
    xmlns:controls="clr-namespace:NexusMods.App.UI.Controls"
    xmlns:mist="clr-namespace:NexusMods.App.UI"
    xmlns:icons="clr-namespace:NexusMods.UI.Sdk.Icons;assembly=NexusMods.UI.Sdk"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
    x:Class="NexusMods.App.UI.Overlays.WelcomeOverlayView">
    
    <Border MinWidth="576" MaxWidth="576"
            Background="{StaticResource SurfaceLowBrush}"
            CornerRadius="8"
            Padding="24"
            BorderBrush="{StaticResource StrokeTranslucentWeakBrush}"
            BorderThickness="2"
            BoxShadow="{StaticResource DropShadowMD}">

        <StackPanel HorizontalAlignment="Center" Spacing="32">
            <StackPanel Spacing="8">
                <icons:UnifiedIcon Value="{x:Static icons:IconValues.InfoFilled}"
                                   Size="56" />

                <StackPanel>
                    <TextBlock Theme="{StaticResource BodyXLBoldTheme}"
                               TextAlignment="Center"
                               Foreground="{StaticResource NeutralStrongBrush}"
                               Text="About"/>
                    <TextBlock Theme="{StaticResource BodyXLBoldTheme}"
                               TextAlignment="Center"
                               Foreground="#00D9FF"
                               Text="M.I.S.T. — Mod Integration and Sorting Technology"/>
                </StackPanel>
                

                <TextBlock Theme="{StaticResource BodyMDNormalTheme}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource NeutralSubduedBrush}"
                           Text="An independent, open-source mod manager derived from Nexus Mods App. Supports separate loadouts, version-aware Steam installations, and local mod management." />
                <TextBlock x:Name="MISTBuildDetails"
                           Theme="{StaticResource BodyMDNormalTheme}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource NeutralSubduedBrush}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Theme="{StaticResource BodyMDNormalTheme}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource NeutralSubduedBrush}"
                           Text="Project and external resources:" />

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Spacing-4}" HorizontalAlignment="Center">

                    <controls:StandardButton x:Name="ButtonOpenForum"
                                             Text="Nexus Mods Forums"
                                             Type="Secondary"
                                             Fill="None"
                                             Size="Small"
                                             ShowIcon="Left"
                                             LeftIcon="{x:Static icons:IconValues.Forum}"
                                             ToolTip.Tip="Open Forums at Nexus Mods" />

                    <controls:StandardButton x:Name="ButtonOpenGitHub" IsVisible="{x:Static mist:ConstantLinks.HasForkGitHub}"
                                             Text="GitHub"
                                             Type="Secondary"
                                             Fill="None"
                                             Size="Small"
                                             ShowIcon="Left"
                                             LeftIcon="{x:Static icons:IconValues.GitHub}"
                                             ToolTip.Tip="M.I.S.T. source repository" />
                </StackPanel>
            </StackPanel>


            <StackPanel Spacing="16">
                <TextBlock Theme="{StaticResource BodyMDNormalTheme}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource NeutralSubduedBrush}"
                           Text="Credits: Nexus Mods App developers and contributors; M.I.S.T. contributors. GPL-3.0 licensed fork; see the included LICENSE and third-party notices. Not affiliated with Nexus Mods." />
                <Border Height="1" Background="{StaticResource SurfaceMidBrush}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="{StaticResource Spacing-4}">

                    <controls:StandardButton x:Name="ButtonClose"
                                             Text="Close"
                                             Type="Tertiary"
                                             Fill="Weak"
                                             Size="Small" />

                    <controls:StandardButton x:Name="ButtonLogIn"
                                             Text="Log in"
                                             Type="Primary"
                                             Fill="Strong"
                                             Size="Small" />

                    <controls:StandardButton x:Name="ButtonLogOut"
                                             Text="Log Out"
                                             Type="Secondary"
                                             Fill="Strong"
                                             Size="Small" />
                </StackPanel>

            </StackPanel>
            
            
        </StackPanel>

    </Border>

</reactive:ReactiveUserControl>
