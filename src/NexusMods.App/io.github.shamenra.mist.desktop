[Desktop Entry]
Type=Application
# Version=1.5
# Commented out because PupNet needs updating to recognise 1.5, so letting it default to latest is ideal.
Name=Mod Integration and Sorting Technology
GenericName=Mod Manager
Comment=Mod Manager for your games
Categories=Game
Terminal=false
StartupWMClass=NexusMods.App
MimeType=x-scheme-handler/nxm
Icon=io.github.shamenra.mist
Exec=${INSTALL_EXEC} %u
X-AppImage-Integrate=true
X-AppImage-Name=ModIntegrationAndSortingTechnology
X-AppImage-Arch=x86_64
