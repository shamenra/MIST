<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <!-- See https://www.freedesktop.org/software/appstream/docs/chap-Metadata.html#spec-component-filespec -->

    <id>io.github.shamenra.mist</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-only</project_license>

    <name>Mod Integration and Sorting Technology</name>
    <summary>Mod Manager for your games</summary>

    <developer id="io.github.shamenra">
        <name>M.I.S.T. Contributors</name>
    </developer>

    <description>
        <p>M.I.S.T. is an independent, community-maintained game mod manager based on the Nexus Mods App.</p>
    </description>

    <branding>
        <color type="primary" scheme_preference="light">#fafafa</color>
        <color type="primary" scheme_preference="dark">#1d1d21</color>
    </branding>

    <launchable type="desktop-id">io.github.shamenra.mist.desktop</launchable>


    <content_rating type="oars-1.0">
        <content_attribute id="social-info">intense</content_attribute>
    </content_rating>

    <categories>
        <category>Game</category>
    </categories>

    <recommends>
        <memory>1024</memory>

        <internet>always</internet>
        <display_length compare="ge">360</display_length>

        <id version="1.0" compare="ge">com.valvesoftware.Steam</id>
    </recommends>

    <supports>
        <id version="1.0" compare="ge">com.heroicgameslauncher.hgl</id>

        <control>gamepad</control>
    </supports>

    <!-- NOTE(erri120): we use a script to turn GitHub releases into a supported format -->
    

</component>
